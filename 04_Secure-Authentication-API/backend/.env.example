# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://authapi:changeme@localhost:5432/authapi

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-long-random-value

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
ENVIRONMENT=development

# Must match exactly where the React dev server / deployed frontend is served
# from — never a wildcard, since the refresh cookie requires allow_credentials.
FRONTEND_ORIGIN=http://localhost:5173
